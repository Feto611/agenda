    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "26.1.0",
    "laravel-vite-plugin": "^2.0.0",
    "tsx": "4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "ws": "8.22.0"
  }
