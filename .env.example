APP_NAME=Encuentro
APP_ENV=local
APP_PREVIOUS_KEYS=
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=encuentro
DB_USERNAME=encuentro
DB_PASSWORD=change_me_before_deployment
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=database
LOG_CHANNEL=stack
LOG_LEVEL=warning
GEOAPIFY_API_KEY=
AI_ALLOWED_HOSTS=api.openai.com,api.anthropic.com,api.groq.com,openrouter.ai
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION="© OpenStreetMap contributors"

# Portales independientes
APP_PORTAL=client
CUSTOMER_URL=http://localhost:8080
OWNER_URL=http://localhost:8081
OWNER_BIND=127.0.0.1
OWNER_PORT=8081
OWNER_SECURE_COOKIE=false
TRUSTED_PROXIES=

# Opcional: lista exacta de servidores SMTP autorizados (reemplaza la lista inicial).
# SMTP_ALLOWED_HOSTS=smtp.resend.com,smtp.postmarkapp.com,smtp.tu-proveedor.com

# WebSocket Reverb: install.sh genera las claves vacías automáticamente. Conserva el secreto solo en servidor.
REALTIME_ENABLED=true
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=encuentro
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
# Opcional: hosts exactos, sin esquema. Por defecto se derivan de CUSTOMER_URL y OWNER_URL.
# REVERB_ALLOWED_ORIGINS=reservas.tu-dominio.com,localhost

# Correo global para recuperación de contraseña (independiente del correo por local).
MAIL_MAILER=smtp
MAIL_HOST=smtp.tu-proveedor.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=cuentas@tu-dominio.com
MAIL_FROM_NAME="Encuentro"

# Opcional: emisión y renovación automática HTTPS mediante compose.https.yaml.
# Requiere dominios públicos con DNS correcto y acceso externo a 80/443.
ACME_EMAIL=

# Registro de negocios: invite (recomendado) u open (registro público explícito).
OWNER_REGISTRATION=invite
